#include <stdio.h>

/*
 * DFA States:
 *   q0 (0): Initial state (no input read)
 *   q1 (1): Started with '0', currently ends in '0' (Non-accepting)
 *   q2 (2): Started with '0', currently ends in '1' (ACCEPTING)
 *   q3 (3): Trap / Dead state (starts with '1' or invalid input)
 */

int main() {
    char str[100];
    int state = 0;

    printf("Enter a binary string: ");
    if (scanf("%99s", str) != 1) return 1;

    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];

        switch (state) {
            case 0:
                if (ch == '0')      state = 1;
                else if (ch == '1') state = 3;
                else                state = 3;
                break;
            case 1:
                if (ch == '0')      state = 1;
                else if (ch == '1') state = 2;
                else                state = 3;
                break;
            case 2:
                if (ch == '0')      state = 1;
                else if (ch == '1') state = 2;
                else                state = 3;
                break;
            case 3:
                break;
        }
    }

    if (state == 2)
        printf("Result: ACCEPTED\n");
    else
        printf("Result: REJECTED\n");

    return 0;
}


