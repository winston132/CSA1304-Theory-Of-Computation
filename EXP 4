#include <stdio.h>
#include <string.h>
#include <stdbool.h>

/*
 * Experiment 4:
 * Question: Write a C program to check whether a given string belongs to the language
 *           defined by the Context Free Grammar (CFG):
 *           S -> 0S0 | 1S1 | 0 | 1 | ε
 *
 * Language Analysis:
 * - Base cases: S -> ε (empty string), S -> 0 (odd palindrome center '0'), S -> 1 (odd palindrome center '1')
 * - Recursive cases: S -> 0S0, S -> 1S1
 * - This grammar generates the language of all binary palindromes:
 *   L = { w in {0, 1}* | w = w^R }
 */

bool isPalindromeCFG(const char *str, int start, int end) {
    if (start >= end) {
        // Base case: 0 characters left (epsilon) or 1 character left ('0' or '1')
        return true;
    }
    
    // Check validity of symbols
    if ((str[start] != '0' && str[start] != '1') || 
        (str[end] != '0' && str[end] != '1')) {
        return false;
    }
    
    // Recursive match corresponding to S -> 0S0 or S -> 1S1
    if (str[start] == str[end]) {
        return isPalindromeCFG(str, start + 1, end - 1);
    }
    
    return false;
}

int main() {
    char str[100];
    
    printf("--- CFG Parser: S -> 0S0 | 1S1 | 0 | 1 | epsilon ---\n");
    printf("Language: All binary palindromes over {0, 1}\n");
    printf("Enter a binary string (or 'E' for epsilon/empty): ");
    
    if (scanf("%99s", str) != 1) {
        return 1;
    }
    
    if (strcmp(str, "E") == 0 || strcmp(str, "e") == 0) {
        str[0] = '\0';
    }
    
    int len = strlen(str);
    bool accepted = isPalindromeCFG(str, 0, len - 1);
    
    printf("\nRecursive Parse Trace:\n");
    for (int i = 0, j = len - 1; i <= j; i++, j--) {
        if (i == j) {
            printf("  Center match (S -> %c): '%c'\n", str[i], str[i]);
        } else if (i < j) {
            printf("  Production S -> %cS%c: matched '%c' and '%c'\n", 
                   str[i], str[j], str[i], str[j]);
        }
    }
    
    if (accepted) {
        printf("\nResult: String \"%s\" is ACCEPTED (Palindromic string generated by CFG)\n", str);
    } else {
        printf("\nResult: String \"%s\" is REJECTED (Not a valid string generated by CFG)\n", str);
    }
    
    return 0;
}


