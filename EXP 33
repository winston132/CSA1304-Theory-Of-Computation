#include <stdio.h>
#include <string.h>

/*
 * Experiment 33:
 * Question: Design DFA using simulator to accept strings having 'abc' as substring
 *           over the set {a, b, c}.
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b, c}
 *   Language L = { (a + b + c)* abc (a + b + c)* }
 *
 * States:
 *   q0 (0): Initial state (no prefix of "abc" matched)
 *   q1 (1): Matched prefix "a"
 *   q2 (2): Matched prefix "ab"
 *   q3 (3): Substring "abc" matched -> ACCEPTING (Absorbing State)
 *
 * Transition Table:
 *   State | 'a' | 'b' | 'c'
 *   ------+-----+-----+-----
 *   q0    | q1  | q0  | q0
 *   q1    | q1  | q2  | q0
 *   q2    | q1  | q0  | q3
 *   q3*   | q3  | q3  | q3
 */

int main() {
    char str[100];
    int state = 0;
    
    printf("--- DFA Simulator: Substring \"abc\" Acceptance ---\n");
    printf("Alphabet: {a, b, c}\n");
    printf("Enter string over {a, b, c}: ");
    
    if (scanf("%99s", str) != 1) return 1;
    
    printf("\nState Transition Trace:\n");
    printf("  Initial State: q%d\n", state);
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        switch (state) {
            case 0:
                if (ch == 'a') state = 1;
                else if (ch == 'b' || ch == 'c') state = 0;
                else state = -1;
                break;
            case 1:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 2;
                else if (ch == 'c') state = 0;
                else state = -1;
                break;
            case 2:
                if (ch == 'c') state = 3; // "abc" completed!
                else if (ch == 'a') state = 1;
                else if (ch == 'b') state = 0;
                else state = -1;
                break;
            case 3:
                if (ch == 'a' || ch == 'b' || ch == 'c') state = 3;
                else state = -1;
                break;
            default:
                state = -1;
                break;
        }
        
        if (state == -1) {
            printf("  Invalid symbol '%c' encountered.\n", ch);
            break;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d%s\n",
               ch, prev, ch, state, (state == 3 && prev != 3) ? " [MATCHED 'abc']" : "");
    }
    
    printf("\nFinal State: q%d\n", state);
    if (state == 3) {
        printf("Result: String \"%s\" is ACCEPTED (Contains substring \"abc\")\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED (Does not contain substring \"abc\")\n", str);
    }
    
    return 0;
}


