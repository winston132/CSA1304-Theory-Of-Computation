#include <stdio.h>
#include <string.h>
#include <stdbool.h>

/*
 * Experiment 14:
 * Question: Design PDA using simulator to accept the input string a^n b^{2n}
 *           (e.g., "abb", "aabbbb", "aaabbbbbb")
 *
 * PDA Formal Specification:
 *   M = (Q, Σ, Γ, δ, q0, Z0, F)
 *   Q  = {q0, q1, q2}
 *   Σ  = {a, b}
 *   Γ  = {Z0, A}
 *   q0 = Start state
 *   Z0 = Initial stack symbol
 *   F  = {q2} (Acceptance by final state)
 *
 * Transitions:
 *   For every 'a' read, push TWO 'A's:
 *     δ(q0, 'a', Z0) = (q0, A A Z0)
 *     δ(q0, 'a', A)  = (q0, A A A)
 *   For every 'b' read, pop ONE 'A':
 *     δ(q0, 'b', A)  = (q1, ε)
 *     δ(q1, 'b', A)  = (q1, ε)
 *   At end of input, when only Z0 remains:
 *     δ(q1, ε,   Z0) = (q2, Z0) [Accept]
 */

#define MAX_STACK 200

char stack[MAX_STACK];
int top = -1;

void push(char c) {
    if (top < MAX_STACK - 1) {
        stack[++top] = c;
    }
}

char pop() {
    if (top >= 0) {
        return stack[top--];
    }
    return '\0';
}

void printStack() {
    printf("[bottom] ");
    for (int i = 0; i <= top; i++) {
        printf("%c ", stack[i]);
    }
    printf("[top]");
}

int main() {
    char str[100];
    
    printf("--- Pushdown Automata (PDA) Simulator for L = { a^n b^(2n) | n >= 1 } ---\n");
    printf("Examples: abb, aabbbb, aaabbbbbb\n");
    printf("Enter string: ");
    
    if (scanf("%99s", str) != 1) return 1;
    
    // Initialize stack
    top = -1;
    push('Z');
    
    int state = 0;
    bool error = false;
    
    printf("\nExecution Trace:\n");
    printf("Initial Config: State q%d, Stack: ", state);
    printStack();
    printf("\n----------------------------------------------------\n");
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        
        if (state == 0) {
            if (ch == 'a') {
                push('A');
                push('A'); // Push two 'A's for every single 'a'
                printf("Read 'a': Push TWO 'A's onto stack -> State q0 | Stack: ", ch);
                printStack();
                printf("\n");
            } else if (ch == 'b') {
                if (top >= 0 && stack[top] == 'A') {
                    pop();
                    state = 1;
                    printf("Read 'b': Pop ONE 'A' from stack  -> State q1 | Stack: ", ch);
                    printStack();
                    printf("\n");
                } else {
                    error = true;
                    break;
                }
            } else {
                error = true;
                break;
            }
        } else if (state == 1) {
            if (ch == 'b') {
                if (top >= 0 && stack[top] == 'A') {
                    pop();
                    printf("Read 'b': Pop ONE 'A' from stack  -> State q1 | Stack: ", ch);
                    printStack();
                    printf("\n");
                } else {
                    error = true;
                    break;
                }
            } else {
                error = true;
                break;
            }
        }
    }
    
    // Check acceptance
    if (!error && state == 1 && top == 0 && stack[top] == 'Z') {
        state = 2; // Final state
        printf("End of input: ε-transition on Z0 -> State q2 (Final State)\n");
    }
    
    printf("----------------------------------------------------\n");
    if (state == 2) {
        printf("Result: String \"%s\" is ACCEPTED by the PDA!\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED by the PDA!\n", str);
    }
    
    return 0;
}


