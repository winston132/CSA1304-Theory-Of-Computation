#include <stdio.h>
#include <string.h>

/*
 * Experiment 25:
 * Question: Design DFA using simulator to accept strings starting with 'a' or 'b'
 *           over the set {a, b}.
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b}
 *   Language L = { (a + b)(a + b)* }  (Any non-empty string over {a, b})
 *
 * States:
 *   q0 (0): Start state (empty string -> Non-accepting)
 *   q1 (1): Started with 'a' or 'b' -> ACCEPTING STATE (Absorbing)
 *   q2 (2): Trap / Dead state (invalid symbol)
 *
 * Transition Table:
 *   State | 'a' | 'b'
 *   ------+-----+-----
 *   q0    | q1  | q1
 *   q1*   | q1  | q1
 *   q2    | q2  | q2
 */

int main() {
    char str[100];
    int state = 0; // q0: Start
    
    printf("--- DFA Simulator: Strings Starting with 'a' or 'b' ---\n");
    printf("Alphabet: {a, b}\n");
    printf("Enter string over {a, b}: ");
    
    if (scanf("%99s", str) != 1) return 1;
    
    printf("\nState Transition Trace:\n");
    printf("  Initial State: q%d (empty string)\n", state);
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        switch (state) {
            case 0:
                if (ch == 'a' || ch == 'b') state = 1;
                else state = 2;
                break;
            case 1:
                if (ch == 'a' || ch == 'b') state = 1;
                else state = 2;
                break;
            case 2:
            default:
                state = 2;
                break;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d\n", ch, prev, ch, state);
    }
    
    printf("\nFinal State: q%d\n", state);
    if (state == 1) {
        printf("Result: String \"%s\" is ACCEPTED (Valid string starting with '%c')\n", str, str[0]);
    } else {
        printf("Result: String \"%s\" is REJECTED\n", str);
    }
    
    return 0;
}


