#include <stdio.h>
#include <string.h>

/*
 * Experiment 34:
 * Question: Design DFA using simulator to accept even number of c's over the set {a, b, c}.
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b, c}
 *   Language L = { w in {a, b, c}* | count of 'c' in w is even }
 *
 * States:
 *   q0 (0): Even count of 'c's -> START STATE & ACCEPTING STATE
 *   q1 (1): Odd count of 'c's  -> Non-accepting state
 *
 * Transition Table:
 *   State | 'a' | 'b' | 'c'
 *   ------+-----+-----+-----
 *   q0*   | q0  | q0  | q1
 *   q1    | q1  | q1  | q0
 */

int main() {
    char str[100];
    int state = 0; // q0: Even count of 'c's
    
    printf("--- DFA Simulator: Accept Strings with Even Number of 'c's ---\n");
    printf("Alphabet: {a, b, c}\n");
    printf("Enter string over {a, b, c} (or 'E' for empty/epsilon): ");
    
    if (scanf("%99s", str) != 1) return 1;
    if (strcmp(str, "E") == 0 || strcmp(str, "e") == 0) str[0] = '\0';
    
    printf("\nState Transition Trace:\n");
    printf("  Initial State: q%d (Even count of 'c's = 0)\n", state);
    
    int count_c = 0;
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        if (ch == 'a' || ch == 'b') {
            state = state; // Unchanged
        } else if (ch == 'c') {
            count_c++;
            state = (state == 0) ? 1 : 0;
        } else {
            printf("Invalid symbol '%c' encountered.\n", ch);
            printf("Result: REJECTED\n");
            return 0;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d (Total 'c's so far: %d)\n",
               ch, prev, ch, state, count_c);
    }
    
    printf("\nFinal State: q%d (Total 'c's = %d)\n", state, count_c);
    if (state == 0) {
        printf("Result: String \"%s\" is ACCEPTED (Even number of 'c's)\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED (Odd number of 'c's)\n", str);
    }
    
    return 0;
}


