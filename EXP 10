#include <stdio.h>
#include <stdbool.h>
#include <string.h>

/*
 * Experiment 10:
 * Question: Write a C program to find ε-closure for all the states in a
 *           Non-Deterministic Finite Automata (NFA) with ε-moves.
 *
 * Theory:
 * - ε-closure(q) is the set of all states that can be reached from state q
 *   by taking only ε (epsilon) transitions, including state q itself.
 * - Algorithm: Depth-First Search (DFS) or transitive closure along ε-transitions.
 */

#define MAX_STATES 20

int n_states;
int n_transitions;
int adj[MAX_STATES][MAX_STATES]; // Epsilon transition adjacency matrix
bool visited[MAX_STATES];

void dfs(int state, bool closure[]) {
    closure[state] = true;
    for (int next = 0; next < n_states; next++) {
        if (adj[state][next] && !closure[next]) {
            dfs(next, closure);
        }
    }
}

int main() {
    printf("--- Computation of ε-Closure for NFA with ε-moves ---\n");
    
    printf("Enter the number of states (e.g., 3): ");
    if (scanf("%d", &n_states) != 1 || n_states <= 0 || n_states > MAX_STATES) {
        printf("Invalid number of states.\n");
        return 1;
    }
    
    // Initialize adjacency matrix to 0
    memset(adj, 0, sizeof(adj));
    
    printf("Enter the number of ε-transitions: ");
    if (scanf("%d", &n_transitions) != 1 || n_transitions < 0) {
        printf("Invalid number of transitions.\n");
        return 1;
    }
    
    printf("Enter ε-transitions as 'source destination' (0-indexed, e.g., 0 1 for q0 -> q1):\n");
    for (int i = 0; i < n_transitions; i++) {
        int u, v;
        printf("  Transition %d: ", i + 1);
        if (scanf("%d %d", &u, &v) == 2) {
            if (u >= 0 && u < n_states && v >= 0 && v < n_states) {
                adj[u][v] = 1;
            } else {
                printf("Invalid state index! Must be between 0 and %d.\n", n_states - 1);
                i--;
            }
        }
    }
    
    printf("\n========================================\n");
    printf("          ε-CLOSURE FOR ALL STATES       \n");
    printf("========================================\n");
    
    for (int i = 0; i < n_states; i++) {
        bool closure[MAX_STATES] = {false};
        dfs(i, closure);
        
        printf("ε-closure(q%d) = { ", i);
        bool first = true;
        for (int j = 0; j < n_states; j++) {
            if (closure[j]) {
                if (!first) printf(", ");
                printf("q%d", j);
                first = false;
            }
        }
        printf(" }\n");
    }
    printf("========================================\n");
    
    return 0;
}


