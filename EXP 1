#include <stdio.h>
#include <string.h>

/*
 * DFA Specification:
 * Alphabet: Σ = {a, b}
 * Language: Strings starting with 'a' and ending with 'a'
 * 
 * States:
 *   q0 (0): Initial state (empty input)
 *   q1 (1): Read 'a' most recently, and started with 'a' -> ACCEPTING STATE
 *   q2 (2): Started with 'a', but read 'b' most recently -> NON-ACCEPTING
 *   q3 (3): Dead / Trap state (started with 'b' or invalid input) -> NON-ACCEPTING
 */

int main() {
    char str[100];
    int state = 0; // Start state q0

    printf("Enter a string over {a, b}: ");
    if (scanf("%99s", str) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];

        switch (state) {
            case 0:
                if (ch == 'a')      state = 1; // Starts with 'a'
                else if (ch == 'b') state = 3; // Starts with 'b' -> Dead state
                else                state = 3; // Invalid symbol
                break;

            case 1:
                if (ch == 'a')      state = 1; // Continues ending in 'a'
                else if (ch == 'b') state = 2; // Now ends in 'b'
                else                state = 3;
                break;

            case 2:
                if (ch == 'a')      state = 1; // Switched back to ending in 'a'
                else if (ch == 'b') state = 2; // Still ends in 'b'
                else                state = 3;
                break;

            case 3: // Trap state remains trapped
                break;
        }
    }

    // State 1 is the only accepting state
    if (state == 1) {
        printf("Result: ACCEPTED\n");
    } else {
        printf("Result: REJECTED\n");
    }

    return 0;
}


