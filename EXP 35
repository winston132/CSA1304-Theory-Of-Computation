#include <stdio.h>
#include <string.h>

/*
 * Experiment 35:
 * Question: Design DFA using simulator to accept strings in which a's always appear tripled
 *           over input {a, b}.
 *
 * Language Specification:
 *   L = (b | aaa)*
 *   Every contiguous block of 'a's must have length that is a multiple of 3.
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b}
 *   States:
 *     q0 (0): 0 modulo 3 'a's in current run -> START STATE & ACCEPTING STATE
 *     q1 (1): 1 modulo 3 'a's (needs two more 'a's) -> Non-accepting
 *     q2 (2): 2 modulo 3 'a's (needs one more 'a')  -> Non-accepting
 *     q3 (3): Trap / Dead state (violation: 'b' arrived before run reached multiple of 3)
 *
 * Transition Table:
 *   State | 'a' | 'b'
 *   ------+-----+-----
 *   q0*   | q1  | q0
 *   q1    | q2  | q3
 *   q2    | q0  | q3
 *   q3    | q3  | q3
 */

int main() {
    char str[100];
    int state = 0; // q0: Start & Accept
    
    printf("--- DFA Simulator: Strings where 'a's always appear Tripled ---\n");
    printf("Language: L = (b | aaa)*\n");
    printf("Enter string over {a, b} (or 'E' for empty/epsilon): ");
    
    if (scanf("%99s", str) != 1) return 1;
    if (strcmp(str, "E") == 0 || strcmp(str, "e") == 0) str[0] = '\0';
    
    printf("\nState Transition Trace:\n");
    printf("  Initial State: q%d\n", state);
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        switch (state) {
            case 0:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 0;
                else state = 3;
                break;
            case 1:
                if (ch == 'a') state = 2;
                else state = 3; // 'b' after 1 'a' violates tripled requirement
                break;
            case 2:
                if (ch == 'a') state = 0; // 3rd 'a' completes triplet!
                else state = 3; // 'b' after 2 'a's violates tripled requirement
                break;
            case 3:
            default:
                state = 3;
                break;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d%s\n",
               ch, prev, ch, state, (state == 3 && prev != 3) ? " [TRAPPED: Violates Tripled Rule]" : "");
    }
    
    printf("\nFinal State: q%d\n", state);
    if (state == 0) {
        printf("Result: String \"%s\" is ACCEPTED ('a's always appear tripled)\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED ('a's do not appear tripled)\n", str);
    }
    
    return 0;
}


