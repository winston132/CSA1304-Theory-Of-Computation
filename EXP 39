#include <stdio.h>
#include <string.h>

/*
 * Experiment 39:
 * Question: Design DFA using simulator to accept the string that ends with 'abc'
 *           over alphabet {a, b, c}.
 *           Test String: W = "abbaababc"
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b, c}
 *   Language L = { (a + b + c)* abc }
 *
 * States:
 *   q0 (0): Neither 'a', "ab", nor "abc" at end -> START STATE
 *   q1 (1): Currently ends in "a"
 *   q2 (2): Currently ends in "ab"
 *   q3 (3): Currently ends in "abc" -> ACCEPTING STATE
 *
 * Transition Table:
 *   State | 'a' | 'b' | 'c'
 *   ------+-----+-----+-----
 *   q0    | q1  | q0  | q0
 *   q1    | q1  | q2  | q0
 *   q2    | q1  | q0  | q3
 *   q3*   | q1  | q0  | q0
 */

int main() {
    char str[100] = "abbaababc";
    int state = 0;
    
    printf("--- DFA Simulator: Strings Ending with \"abc\" ---\n");
    printf("Alphabet: {a, b, c}\n");
    printf("Target Test String: W = \"abbaababc\"\n");
    printf("Enter string over {a, b, c} (press Enter for default \"abbaababc\"): ");
    
    char user_input[100];
    if (fgets(user_input, sizeof(user_input), stdin) != NULL) {
        user_input[strcspn(user_input, "\r\n")] = '\0';
        if (strlen(user_input) > 0) {
            strncpy(str, user_input, sizeof(str) - 1);
            str[sizeof(str) - 1] = '\0';
        }
    }
    
    printf("\nState Transition Trace for W = \"%s\":\n", str);
    printf("  Initial State: q%d\n", state);
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        switch (state) {
            case 0:
                if (ch == 'a') state = 1;
                else if (ch == 'b' || ch == 'c') state = 0;
                else state = -1;
                break;
            case 1:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 2;
                else if (ch == 'c') state = 0;
                else state = -1;
                break;
            case 2:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 0;
                else if (ch == 'c') state = 3; // Matched "abc"!
                else state = -1;
                break;
            case 3:
                if (ch == 'a') state = 1;
                else if (ch == 'b' || ch == 'c') state = 0;
                else state = -1;
                break;
            default:
                state = -1;
                break;
        }
        
        if (state == -1) {
            printf("  Invalid symbol '%c' encountered.\n", ch);
            break;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d\n", ch, prev, ch, state);
    }
    
    printf("\nFinal State: q%d\n", state);
    if (state == 3) {
        printf("Result: String \"%s\" is ACCEPTED (Ends with \"abc\")\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED (Does not end with \"abc\")\n", str);
    }
    
    return 0;
}


