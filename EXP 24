#include <stdio.h>
#include <string.h>

/*
 * Experiment 24:
 * Question: Design DFA using simulator to accept the string having 'ab' as substring
 *           over the set {a, b}.
 *
 * DFA Formal Specification:
 *   Alphabet Σ = {a, b}
 *   Language L = { (a + b)* ab (a + b)* }
 *
 * States:
 *   q0 (0): Initial state (no 'a' seen yet)
 *   q1 (1): Saw 'a' (candidate for start of "ab")
 *   q2 (2): "ab" substring found -> ACCEPTING (Trap / Absorbing state)
 *
 * Transition Table:
 *   State | 'a' | 'b'
 *   ------+-----+-----
 *   q0    | q1  | q0
 *   q1    | q1  | q2
 *   q2*   | q2  | q2
 */

int main() {
    char str[100];
    int state = 0;
    
    printf("--- DFA Simulator: Substring \"ab\" Acceptance ---\n");
    printf("Alphabet: {a, b}\n");
    printf("Enter string over {a, b}: ");
    
    if (scanf("%99s", str) != 1) return 1;
    
    printf("\nState Transition Trace:\n");
    printf("  Initial State: q%d\n", state);
    
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        int prev = state;
        
        switch (state) {
            case 0:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 0;
                else state = -1;
                break;
            case 1:
                if (ch == 'a') state = 1;
                else if (ch == 'b') state = 2; // Matched "ab"!
                else state = -1;
                break;
            case 2:
                if (ch == 'a' || ch == 'b') state = 2; // Stay in accepting state
                else state = -1;
                break;
            default:
                state = -1;
                break;
        }
        
        if (state == -1) {
            printf("  Invalid symbol '%c' encountered.\n", ch);
            break;
        }
        
        printf("  Read '%c': δ(q%d, '%c') -> q%d%s\n",
               ch, prev, ch, state, (state == 2 && prev != 2) ? " [MATCHED 'ab']" : "");
    }
    
    printf("\nFinal State: q%d\n", state);
    if (state == 2) {
        printf("Result: String \"%s\" is ACCEPTED (Contains substring \"ab\")\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED (Does not contain substring \"ab\")\n", str);
    }
    
    return 0;
}


