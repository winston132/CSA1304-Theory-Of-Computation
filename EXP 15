#include <stdio.h>
#include <string.h>
#include <stdbool.h>

/*
 * Experiment 15:
 * Question: Design TM using simulator to accept the input string a^n b^n
 *
 * Turing Machine Formal Specification:
 *   M = (Q, Σ, Γ, δ, q0, B, F)
 *   Q = {q0, q1, q2, q3, q4}
 *   Σ = {a, b}
 *   Γ = {a, b, X, Y, B}
 *   q0 = Start state
 *   B  = Blank symbol
 *   F  = {q4} (Halt & Accept)
 *
 * Transition Logic:
 *   q0: Replace 'a' with 'X', Move R -> q1
 *       If 'Y' read, Move R -> q3 (Verify remaining are all 'Y')
 *   q1: Skip 'a' and 'Y' moving Right until first 'b'
 *       Replace 'b' with 'Y', Move L -> q2
 *   q2: Skip 'Y' and 'a' moving Left until 'X'
 *       Move R -> q0
 *   q3: Skip 'Y' moving Right until 'B'
 *       On 'B', Halt -> q4 (ACCEPT)
 */

#define TAPE_SIZE 200

char tape[TAPE_SIZE];
int head = 20; // Start comfortably after padding
int state = 0;

void printTape() {
    printf("State [q%d] Tape: ... ", state);
    int start = 18;
    int end = 35;
    for (int i = start; i <= end; i++) {
        if (i == head) printf("[%c]", tape[i]);
        else printf(" %c ", tape[i]);
    }
    printf(" ...\n");
}

int main() {
    char str[100];
    
    printf("--- Turing Machine Simulator for L = { a^n b^n | n >= 1 } ---\n");
    printf("Enter input string (e.g., aabb): ");
    
    if (scanf("%99s", str) != 1) return 1;
    
    // Initialize tape with blank symbol 'B'
    for (int i = 0; i < TAPE_SIZE; i++) tape[i] = 'B';
    
    // Load input string onto tape starting at index 20
    int input_start = 20;
    int len = strlen(str);
    for (int i = 0; i < len; i++) {
        tape[input_start + i] = str[i];
    }
    
    head = input_start;
    state = 0;
    
    printf("\nExecution Tape Trace:\n");
    printTape();
    
    int max_steps = 1000;
    int step = 0;
    bool halted = false;
    
    while (!halted && step < max_steps) {
        step++;
        char symbol = tape[head];
        
        switch (state) {
            case 0:
                if (symbol == 'a') {
                    tape[head] = 'X';
                    head++;
                    state = 1;
                } else if (symbol == 'Y') {
                    head++;
                    state = 3;
                } else {
                    halted = true; // Reject
                }
                break;
                
            case 1:
                if (symbol == 'a' || symbol == 'Y') {
                    head++;
                } else if (symbol == 'b') {
                    tape[head] = 'Y';
                    head--;
                    state = 2;
                } else {
                    halted = true; // Reject
                }
                break;
                
            case 2:
                if (symbol == 'a' || symbol == 'Y') {
                    head--;
                } else if (symbol == 'X') {
                    head++;
                    state = 0;
                } else {
                    halted = true; // Reject
                }
                break;
                
            case 3:
                if (symbol == 'Y') {
                    head++;
                } else if (symbol == 'B') {
                    state = 4; // ACCEPT state
                    halted = true;
                } else {
                    halted = true; // Reject
                }
                break;
                
            default:
                halted = true;
                break;
        }
        
        printTape();
    }
    
    printf("\n----------------------------------------------------\n");
    if (state == 4) {
        printf("Result: String \"%s\" is ACCEPTED by the Turing Machine!\n", str);
    } else {
        printf("Result: String \"%s\" is REJECTED by the Turing Machine!\n", str);
    }
    
    return 0;
}


